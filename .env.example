OPENAI_API_KEY=your_hf_key_here

OPENAI_BASE_URL=https://router.huggingface.co/v1

MODEL_NAME=Qwen/Qwen3.8-27B
# Для локального Ollama run.sh прогревает модель в фоне и держит её загруженной.
# AI_DM_LOCAL_WARMUP=1
# OLLAMA_KEEP_ALIVE=15m
# OLLAMA_WARMUP_TIMEOUT_SECONDS=180
# Rules Service (integration.build_orchestrator)
RULES_BOOK_PATH=data/srd.md
RULES_MODE=keyword
# RULES_CACHE_DIR=.rules_index
# RULES_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# RULES_LEXICON=1   # 0 turns off the Russian->English glossary for keyword search
